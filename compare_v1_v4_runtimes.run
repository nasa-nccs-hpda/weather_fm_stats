#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
short_yaml="${repo_dir}/example_yaml_files/short_exp/AIFS_ERA5_ERA5_MAY_2024.yaml"
long_yaml="${repo_dir}/example_yaml_files/long_exp/AIFS_ERA5_ERA5_MAY_2024.yaml"
poll_seconds="${STEP12_POLL_SECONDS:-30}"

if [[ "${COMPARE_V1_V4_LOG_ACTIVE:-0}" != "1" ]]; then
    log_dir="${repo_dir}/logs"
    mkdir -p "$log_dir"
    transcript_log="${log_dir}/compare_v1_v4_runtimes_$(date +%Y%m%d_%H%M%S).log"
    echo "Writing comparison transcript to: $transcript_log"
    COMPARE_V1_V4_LOG_ACTIVE=1 "$0" "$@" 2>&1 | tee "$transcript_log"
    exit "${PIPESTATUS[0]}"
fi

declare -a result_labels=()
declare -a result_v1_seconds=()
declare -a result_current_seconds=()
declare -a result_v1_outputs=()
declare -a result_current_outputs=()
missing_output_count=0

require_file() {
    local path="$1"
    if [[ ! -f "$path" ]]; then
        echo "Error: required file not found: $path" >&2
        exit 1
    fi
}

elapsed_hms() {
    local seconds="$1"
    printf '%02d:%02d:%02d' \
        "$((seconds / 3600))" \
        "$(((seconds % 3600) / 60))" \
        "$((seconds % 60))"
}

yaml_value() {
    local yaml_path="$1"
    local key="$2"
    awk -v key="$key" '
        /^[[:space:]]*#/ { next }
        $0 ~ "^[[:space:]]*" key ":" {
            sub(".*" key ":[[:space:]]*", "")
            sub("[[:space:]]*#.*", "")
            gsub("^[[:space:]]+|[[:space:]]+$", "")
            print
            exit
        }
    ' "$yaml_path"
}

expected_output_paths() {
    local version="$1"
    local yaml_path="$2"
    local output_root
    if [[ "$version" == "current" ]]; then
        output_root="${repo_dir}/outputs"
    elif [[ "$version" == "v1" ]]; then
        output_root="${repo_dir}/archives/legacy_versions/v1/outputs"
    else
        output_root="${repo_dir}/${version}/outputs"
    fi

    local fcst_model
    local ana_model
    local clim_model
    local start_date
    local end_date
    local fcst_length
    local fcst_interval
    local fcst_spacing
    local nlat
    local nlon
    local stats_types
    local suffix

    fcst_model="$(yaml_value "$yaml_path" "fcst_model")"
    ana_model="$(yaml_value "$yaml_path" "ana_model")"
    clim_model="$(yaml_value "$yaml_path" "clim_model")"
    start_date="$(yaml_value "$yaml_path" "start_date")"
    end_date="$(yaml_value "$yaml_path" "end_date")"
    fcst_length="$(yaml_value "$yaml_path" "fcst_length")"
    fcst_interval="$(yaml_value "$yaml_path" "fcst_interval")"
    fcst_spacing="$(yaml_value "$yaml_path" "fcst_spacing")"
    nlat="$(yaml_value "$yaml_path" "Nlat")"
    nlon="$(yaml_value "$yaml_path" "Nlon")"
    stats_types="$(yaml_value "$yaml_path" "stats_types")"

    if [[ -z "$fcst_spacing" ]]; then
        fcst_spacing=1
    fi
    if [[ -z "$stats_types" ]]; then
        stats_types=both
    fi

    suffix="${start_date}-${end_date}_len${fcst_length}d_int${fcst_interval}h_spc${fcst_spacing}d_${nlat}x${nlon}.nc4"

    printf '%s\n' "${output_root}/fcst_${fcst_model}_${suffix}"
    printf '%s\n' "${output_root}/ana_${ana_model}_${suffix}"
    printf '%s\n' "${output_root}/clim_${clim_model}_${suffix}"

    if [[ "$stats_types" == "regional" || "$stats_types" == "both" ]]; then
        printf '%s\n' "${output_root}/stats_regional_${fcst_model}_${ana_model}_${clim_model}_${suffix}"
    fi
    if [[ "$stats_types" == "global" || "$stats_types" == "both" ]]; then
        printf '%s\n' "${output_root}/stats_global_${fcst_model}_${ana_model}_${clim_model}_${suffix}"
    fi
}

validate_workflow_outputs() {
    local version="$1"
    local yaml_path="$2"
    local label="$3"
    local expected_file
    local missing=0
    local total=0

    echo
    echo "Checking expected $version outputs for $label"
    while IFS= read -r expected_file; do
        total="$((total + 1))"
        if [[ -f "$expected_file" ]]; then
            echo "  OK: ${expected_file}"
        else
            echo "  MISSING: ${expected_file}"
            missing="$((missing + 1))"
        fi
    done < <(expected_output_paths "$version" "$yaml_path")

    if ((missing > 0)); then
        missing_output_count="$((missing_output_count + missing))"
        echo "  Result: MISSING ${missing}/${total} expected file(s)"
        return 1
    fi

    echo "  Result: OK ${total}/${total} expected file(s)"
    return 0
}

extract_job_ids() {
    local log_file="$1"
    awk '
        /Submitted:/ {
            for (i = 1; i <= NF; i++) {
                if ($i == "Submitted:") {
                    print $(i + 1)
                }
            }
        }
        /^Job ID:/ {
            print $3
        }
    ' "$log_file" | sed 's/;.*//' | sort -u
}

jobs_running() {
    local job_list="$1"
    local -a job_ids
    local job_id

    IFS=',' read -r -a job_ids <<< "$job_list"
    for job_id in "${job_ids[@]}"; do
        if squeue -h -j "$job_id" 2>/dev/null | grep -q .; then
            return 0
        fi
    done
    return 1
}

wait_for_experiment_jobs() {
    local label="$1"
    local v1_start="$2"
    local current_start="$3"
    local v1_jobs="$4"
    local current_jobs="$5"
    local v1_count="$6"
    local current_count="$7"

    echo "Waiting for $label v1 jobs to finish (${v1_count} job(s)): $v1_jobs"
    echo "Waiting for $label current jobs to finish (${current_count} job(s)): $current_jobs"

    local v1_done=0
    local current_done=0
    local v1_end=0
    local current_end=0

    while ((v1_done == 0 || current_done == 0)); do
        if ((v1_done == 0)) && ! jobs_running "$v1_jobs"; then
            v1_done=1
            v1_end="$(date +%s)"
            echo "$label v1 jobs finished."
        fi
        if ((current_done == 0)) && ! jobs_running "$current_jobs"; then
            current_done=1
            current_end="$(date +%s)"
            echo "$label current jobs finished."
        fi
        if ((v1_done == 0 || current_done == 0)); then
            sleep "$poll_seconds"
        fi
    done

    result_labels+=("$label")
    result_v1_seconds+=("$((v1_end - v1_start))")
    result_current_seconds+=("$((current_end - current_start))")
}

submit_workflow() {
    local version="$1"
    local yaml_path="$2"
    local label="$3"
    local submit_log="$4"

    echo "Submitting $version workflow for $label"
    if [[ "$version" == "v1" ]]; then
        chmod +x "${repo_dir}/archives/legacy_versions/v1/stats_trimmed.run"
        (
            cd "${repo_dir}/archives/legacy_versions/v1"
            ./stats_trimmed.run "$yaml_path"
        ) | tee "$submit_log"
    elif [[ "$version" == "current" ]]; then
        chmod +x "${repo_dir}/sbatch_stats.run"
        (
            cd "${repo_dir}"
            FOLLOW_LOG=0 ./sbatch_stats.run "$yaml_path"
        ) | tee "$submit_log"
    else
        echo "Error: unsupported workflow version: $version" >&2
        exit 1
    fi
}

run_side_by_side_experiment() {
    local label="$1"
    local yaml_path="$2"
    local submit_dir="${repo_dir}/step12_submit_logs"
    mkdir -p "$submit_dir"

    local stamp
    stamp="$(date +%Y%m%d_%H%M%S)"
    local v1_log="${submit_dir}/${label}_v1_${stamp}.log"
    local current_log="${submit_dir}/${label}_current_${stamp}.log"

    echo
    echo "======================================================================"
    echo "STEP 12 EXPERIMENT: ${label}"
    echo "YAML: ${yaml_path}"
    echo "======================================================================"

    local v1_start
    local current_start
    local -a v1_jobs
    local -a current_jobs
    v1_start="$(date +%s)"
    submit_workflow "v1" "$yaml_path" "$label" "$v1_log"
    mapfile -t v1_jobs < <(extract_job_ids "$v1_log")
    if [[ "${#v1_jobs[@]}" -eq 0 ]]; then
        echo "Error: no SLURM job IDs captured for $label v1" >&2
        exit 1
    fi
    echo "Captured ${#v1_jobs[@]} v1 SLURM job ID(s) for $label."
    echo "These include every v1 job printed by stats_trimmed.run: dataset,"
    echo "forecast chunk, merge, statistics, and cleanup jobs."

    current_start="$(date +%s)"
    submit_workflow "current" "$yaml_path" "$label" "$current_log"
    mapfile -t current_jobs < <(extract_job_ids "$current_log")
    if [[ "${#current_jobs[@]}" -eq 0 ]]; then
        echo "Error: no SLURM job IDs captured for $label current" >&2
        exit 1
    fi
    echo "Captured ${#current_jobs[@]} current SLURM job ID(s) for $label."

    local v1_job_list
    local current_job_list
    v1_job_list="$(IFS=,; echo "${v1_jobs[*]}")"
    current_job_list="$(IFS=,; echo "${current_jobs[*]}")"
    wait_for_experiment_jobs "$label" "$v1_start" "$current_start" \
        "$v1_job_list" "$current_job_list" "${#v1_jobs[@]}" "${#current_jobs[@]}"

    local v1_output_status="OK"
    local current_output_status="OK"
    validate_workflow_outputs "v1" "$yaml_path" "$label" || v1_output_status="MISSING"
    validate_workflow_outputs "current" "$yaml_path" "$label" || current_output_status="MISSING"

    echo
    echo "Completed $label experiment"
    local result_index
    result_index="$((${#result_labels[@]} - 1))"
    echo "  v1 elapsed: $(elapsed_hms "${result_v1_seconds[$result_index]}")"
    echo "  current elapsed: $(elapsed_hms "${result_current_seconds[$result_index]}")"
    echo "  v1 outputs: $v1_output_status"
    echo "  current outputs: $current_output_status"
    result_v1_outputs+=("$v1_output_status")
    result_current_outputs+=("$current_output_status")
}

print_summary() {
    echo
    echo "======================================================================"
    echo "STEP 12 OLD VS NEW TIMING SUMMARY"
    echo "======================================================================"
    printf '%-12s %-14s %-14s %-14s %-10s %-10s\n' \
        "Experiment" "v1 elapsed" "current" "current-v1" "v1 files" "current"

    local i
    for i in "${!result_labels[@]}"; do
        local v1="${result_v1_seconds[$i]}"
        local current="${result_current_seconds[$i]}"
        local delta="$((current - v1))"
        local delta_text
        if ((delta < 0)); then
            local abs_delta="$((-delta))"
            delta_text="-$(elapsed_hms "$abs_delta")"
        else
            delta_text="+$(elapsed_hms "$delta")"
        fi
        printf '%-12s %-14s %-14s %-14s %-10s %-10s\n' \
            "${result_labels[$i]}" \
            "$(elapsed_hms "$v1")" \
            "$(elapsed_hms "$current")" \
            "$delta_text" \
            "${result_v1_outputs[$i]}" \
            "${result_current_outputs[$i]}"
    done
}

require_file "$short_yaml"
require_file "$long_yaml"
require_file "${repo_dir}/archives/legacy_versions/v1/stats_trimmed.run"
require_file "${repo_dir}/sbatch_stats.run"

echo "Step 12 old vs new workflow comparison"
echo "Repo: $repo_dir"
echo "Short YAML: $short_yaml"
echo "Long YAML:  $long_yaml"
echo "Poll interval: ${poll_seconds}s"

run_side_by_side_experiment "short" "$short_yaml"
run_side_by_side_experiment "long" "$long_yaml"
print_summary

if ((missing_output_count > 0)); then
    echo
    echo "Error: missing ${missing_output_count} expected output file(s)." >&2
    exit 1
fi
