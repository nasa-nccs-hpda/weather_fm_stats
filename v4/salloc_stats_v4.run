#!/bin/csh -f

# v4 allocation-node entrypoint.
# Runs the full Python pipeline directly inside the current allocation.
# Dataset/statistics chunk parallelism happens inside this one process tree.

source /usr/share/lmod/lmod/init/csh
module load python/GEOSpyD

# Create unique timestamp for job files
set timestamp = `date +%Y%m%d_%H%M%S`

# Handle optional generate-only mode and YAML filename argument
set generate_only = 0
if ($#argv >= 1) then
    if ("$argv[1]" == "--generate-only") then
        set generate_only = 1
        if ($#argv >= 2) then
            set filename = "$argv[2]"
        else
            set filename = "stats.yaml"
        endif
    else
        set filename = "$argv[1]"
    endif
else
    set filename = "stats.yaml"
endif

# Check if YAML file exists before proceeding
if (! -f "$filename") then
    echo "Error: YAML file '$filename' not found"
    exit 1
endif

# Read and validate model names
foreach model_name ("fcst_model" "ana_model" "clim_model")
    set model_value = `grep -v '^[[:space:]]*#' ${filename} | grep "${model_name}:" | sed "s/.*${model_name}:[[:space:]]*//" | sed 's/[[:space:]]*#.*//' | sed '/[^[:alnum:]]/q1'`
    if ($status != 0) then
        echo "Error: $model_name contains non-alphanumeric characters"
        exit 1
    endif
    set $model_name = "$model_value"
end

echo "Models: fcst=$fcst_model, ana=$ana_model, clim=$clim_model"

# Read parameters from config file
set start_date  = `grep -v '^[[:space:]]*#' ${filename} | grep "start_date:"    | awk '{print $2}' | sed 's/[#].*//'`
set end_date    = `grep -v '^[[:space:]]*#' ${filename} | grep "end_date:"      | awk '{print $2}' | sed 's/[#].*//'`

# Make directories
setenv work_dir `pwd`
set out_dir = ${work_dir}/outputs
set sts_dir = stats_${fcst_model}_${ana_model}_${clim_model}_${start_date}-${end_date}_${timestamp}
set log_dir = `pwd`/outputs/${sts_dir}/logs
set job_dir = `pwd`/outputs/${sts_dir}/jobs
set tmp_dir = `pwd`/outputs/${sts_dir}/tmp
mkdir -p ${out_dir}
mkdir -p ${log_dir}
mkdir -p ${job_dir}
mkdir -p ${tmp_dir}

# Create a versioned copy of the YAML file
set versioned_yaml = ${job_dir}/stats_${fcst_model}_${ana_model}_${clim_model}.yaml
cp $filename $versioned_yaml
echo "Created versioned config: $versioned_yaml"

# Read SBATCH parameters from config file
set account   = `grep -v '^[[:space:]]*#' ${versioned_yaml} | grep "account:"      | awk '{print $2}' | sed 's/[#].*//'`
set partition = `grep -v '^[[:space:]]*#' ${versioned_yaml} | grep "partition:"    | awk '{print $2}' | sed 's/[#].*//'`
set qos       = `grep -v '^[[:space:]]*#' ${versioned_yaml} | grep "qos:"          | awk '{print $2}' | sed 's/[#].*//'`
set constraint = `grep -v '^[[:space:]]*#' ${versioned_yaml} | grep "constraint:"  | awk '{print $2}' | sed 's/[#].*//'`

if ("$account" == "" || "$partition" == "" || "$qos" == "") then
    echo "Error: Missing required SBATCH parameters in config file"
    exit 1
endif

echo "Using SBATCH parameters: account=$account partition=$partition qos=$qos"

# Single-job resource defaults (override in YAML if provided)
set pipeline_time = `grep -v '^[[:space:]]*#' ${versioned_yaml} | grep "pipeline_time:" | awk '{print $2}' | sed 's/[#].*//'`
set pipeline_mem = `grep -v '^[[:space:]]*#' ${versioned_yaml} | grep "pipeline_mem:" | awk '{print $2}' | sed 's/[#].*//'`
set pipeline_cpus = `grep -v '^[[:space:]]*#' ${versioned_yaml} | grep "pipeline_cpus:" | awk '{print $2}' | sed 's/[#].*//'`
set pipeline_gres = `grep -v '^[[:space:]]*#' ${versioned_yaml} | grep "pipeline_gres:" | awk '{print $2}' | sed 's/[#].*//'`

if ("$pipeline_time" == "") set pipeline_time = "08:00:00"
if ("$pipeline_mem" == "") set pipeline_mem = "450G"
if ("$pipeline_cpus" == "") set pipeline_cpus = "48"

# Determine stats modes to run
set stats_types = `grep -v '^[[:space:]]*#' ${versioned_yaml} | grep "stats_types:" | sed 's/.*stats_types:[[:space:]]*//' | sed 's/[[:space:]]*#.*//'`
if ("$stats_types" == "") set stats_types = "both"

set run_regional = 0
set run_global = 0
if ("$stats_types" == "regional" || "$stats_types" == "both") set run_regional = 1
if ("$stats_types" == "global" || "$stats_types" == "both") set run_global = 1

if (! $run_regional && ! $run_global) then
    echo "Error: stats_types must be one of regional, global, or both"
    exit 1
endif

echo "Stats types to run: $stats_types (regional=$run_regional, global=$run_global)"

# Build one direct execution script for the allocated node.
set pipeline_script = "${job_dir}/stats_pipeline_direct.j"
printf '#\041/bin/csh -e\n' > $pipeline_script
echo "source /usr/share/lmod/lmod/init/csh" >> $pipeline_script
echo "module load python/GEOSpyD" >> $pipeline_script
echo "cd ${work_dir}" >> $pipeline_script
echo "" >> $pipeline_script

# Run one v4 orchestrator command.
echo "python -u ${work_dir}/stats_v4.py --config ${versioned_yaml} --pipeline --stats_types ${stats_types} --info_dir ${sts_dir}" >> $pipeline_script

chmod +x $pipeline_script

if ($generate_only) then
    echo ""
    echo "Generate-only mode enabled."
    echo "Created direct pipeline script: $pipeline_script"
    echo "No workflow was executed. Re-run without --generate-only to execute one v4 pipeline."
    exit 0
endif

echo ""
echo "Starting single v4 pipeline directly on allocated node."
echo "No external dependency chain or job array will be created."
echo "Pipeline script: $pipeline_script"
set direct_log = ${log_dir}/stats_v4_pipeline_direct.${timestamp}.out
echo "Log file: $direct_log"
echo ""

bash -o pipefail -c "$pipeline_script 2>&1 | tee $direct_log"
set pipeline_exit_code = $status

if ($pipeline_exit_code != 0) then
    echo ""
    echo "Pipeline failed with exit code: $pipeline_exit_code"
    echo "Pipeline script: $pipeline_script"
    echo "Log file: $direct_log"
    exit $pipeline_exit_code
endif

echo ""
echo "Single v4 pipeline completed successfully."
echo "Pipeline script: $pipeline_script"
echo "Log file: $direct_log"
